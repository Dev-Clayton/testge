{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index\\.php", "dest": "/api/index.php" },
    { "src": "/guia\\.php", "dest": "/api/guia.php" },
    { "src": "/api\\.php", "dest": "/api/api.php" },
    { "src": "/epg\\.php", "dest": "/api/epg.php" },
    { "src": "/events\\.php", "dest": "/api/events.php" }
  ]
}
