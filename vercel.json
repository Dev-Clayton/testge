{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index.php" },
    { "source": "/index.php", "destination": "/api/index.php" },
    { "source": "/guia.php", "destination": "/api/guia.php" },
    { "source": "/api.php", "destination": "/api/api.php" },
    { "source": "/epg.php", "destination": "/api/epg.php" },
    { "source": "/events.php", "destination": "/api/events.php" }
  ]
}
